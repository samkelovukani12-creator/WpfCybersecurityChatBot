<Window x:Class="WpfCybersecurityChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCybersecurityChatBot"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Image HorizontalAlignment="Center" Height="112" Margin="0,10,0,0" VerticalAlignment="Top" Width="183" Source="/cybersecurity_final.png"/>
        <Label Content="Cyber Chat" HorizontalAlignment="Center" Margin="0,127,0,0" VerticalAlignment="Top" FontSize="22" FontFamily="Arial Black"/>
        <StackPanel Margin="0,165,0,67">

            <Grid>
                <Image Height="45" Width="45" Source="/User.jpg" Margin="55,0,0,0" HorizontalAlignment="Right"/>
                <Label Content="User" HorizontalAlignment="Right" Margin="42"/>
            </Grid>
            <Grid>
                <Image Height="45" Width="45" Source="/ChatBot.png" Margin="0,0,0,0" HorizontalAlignment="Left"/>
                <Label Content="ChatBot" HorizontalAlignment="Left" Margin="42"/>
            </Grid>
        </StackPanel>
        <TextBox HorizontalAlignment="Left" Margin="55,386,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="466" Height="26"/>
        <Button Content="Send Messege" HorizontalAlignment="Left" Margin="557,386,0,0" VerticalAlignment="Top" Width="92" Height="26" Click="Button_Click" FontWeight="Bold"/>


    </Grid>
</Window>
