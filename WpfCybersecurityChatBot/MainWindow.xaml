<Window x:Class="WpfCybersecurityChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCybersecurityChatBot"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">



    <Grid>
        <Image HorizontalAlignment="Center" Height="112" Margin="0,10,0,0" VerticalAlignment="Top" Width="183" Source="/cybersecurity_final.png"/>
        <Label Content="Cyber Chat" HorizontalAlignment="Center" Margin="0,127,0,0" VerticalAlignment="Top" FontSize="22" FontFamily="Arial Black"/>
        <!-- Conversation area -->
        <ScrollViewer x:Name="ChatScrollViewer"
              Margin="15,165,15,67"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ChatPanel" Orientation="Vertical"/>
        </ScrollViewer>



        <Grid Margin="15">
            <Grid.RowDefinitions>
                <!-- Header at the top -->
                <RowDefinition Height="100"/>

                <!-- Chat conversation fills available space -->
                <RowDefinition Height="*"/>

                <!-- Text box and button stay at the bottom -->
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Bottom input area -->
            <Grid Grid.Row="2"
          VerticalAlignment="Bottom"
          Margin="0,5,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <!-- Text box -->
                <TextBox x:Name="txtInput"
                 Grid.Column="0"
                 Height="38"
                 FontSize="14"
                 Padding="8"
                 VerticalContentAlignment="Center"
                 Margin="0,0,10,0"
                 ToolTip="Type your message">
                </TextBox>
                 

                <!-- Send button -->
                <Button x:Name="sendMessage" Grid.Column="1"
                Content="Send Message"
                Height="38"
                VerticalAlignment="Center"
                Background="DarkTurquoise"
                Foreground="White"
                FontWeight="Bold"
                Click="Button_Click"/>
            </Grid>
        </Grid>

    </Grid>
</Window>
